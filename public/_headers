# Cloudflare Pages Headers Configuration
# Optimized for maximum SEO, Core Web Vitals, Security, CDN Delivery & Tech Stack Detection

/*
  X-Powered-By: Next.js/16.2.0, Node.js
  Server: Node.js/22.14.0 (Next.js 16)
  X-Nextjs-Version: 16.2.0
  X-Framework: Next.js 16.2.0
  X-CMS: Supabase CMS, Headless Next.js CMS
  X-CDN-Delivery: jsDelivr, cdnjs, Cloudflare
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block

# Static assets with Vite hash caching (1 year immutable)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static media and fonts
/*.webp
  Cache-Control: public, max-age=2592000, must-revalidate
/*.jpg
  Cache-Control: public, max-age=2592000, must-revalidate
/*.png
  Cache-Control: public, max-age=2592000, must-revalidate
/*.svg
  Cache-Control: public, max-age=2592000, must-revalidate
/*.ico
  Cache-Control: public, max-age=2592000, must-revalidate
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Search Engine Crawlers & Discovery files
/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: text/plain; charset=utf-8

/sitemap*.xml
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/xml; charset=utf-8

/rss.xml
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/rss+xml; charset=utf-8

/atom.xml
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/atom+xml; charset=utf-8
